# PostgreSQL — data is stored in the named Docker volume.
POSTGRES_USER=royalskye
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=royalskye_pos

# Replace with a long random secret before running the application.
JWT_SECRET=replace-with-a-long-random-secret

# Local-only browser origins.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Keep this project separate from an existing POS instance.
FRONTEND_HOST_PORT=5174
BACKEND_HOST_PORT=8001

# Leave blank to use the same-origin Nginx /api and WebSocket proxy.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
